# Jenkins controller URL reachable from these containers.
JENKINS_URL=http://jenkins:8080

# Docker network where the Jenkins controller container is connected.
# Check with: docker network ls
JENKINS_DOCKER_NETWORK=jenkins-sonarqube-docker_jenkins-sonarqube-network

# Set to true to use WebSocket transport (recommended).
JENKINS_WEB_SOCKET=true

# Agent 01 identity in Jenkins node configuration.
JENKINS_AGENT_01_NAME=docker-agent-01
JENKINS_AGENT_01_CONTAINER_NAME=jenkins-agent-01
JENKINS_AGENT_01_SECRET=replace_with_real_secret_01

# Agent 02 identity in Jenkins node configuration.
JENKINS_AGENT_02_NAME=docker-agent-02
JENKINS_AGENT_02_CONTAINER_NAME=jenkins-agent-02
JENKINS_AGENT_02_SECRET=replace_with_real_secret_02

# Agent 03 identity in Jenkins node configuration.
JENKINS_AGENT_03_NAME=docker-agent-03
JENKINS_AGENT_03_CONTAINER_NAME=jenkins-agent-03
JENKINS_AGENT_03_SECRET=replace_with_real_secret_03