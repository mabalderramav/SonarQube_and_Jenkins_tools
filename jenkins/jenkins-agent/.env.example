# Jenkins controller URL reachable from this container.
JENKINS_URL=http://jenkins:8080

# Docker network where the Jenkins controller container is connected.
# Check with: docker network ls
JENKINS_DOCKER_NETWORK=miasoftnanus-network

# Agent identity in Jenkins node configuration.
JENKINS_AGENT_NAME=docker-agent-01
JENKINS_AGENT_CONTAINER_NAME=jenkins-agent-01

# Set to true to use WebSocket transport (recommended).
JENKINS_WEB_SOCKET=true

# Required: copy from Jenkins > Manage Nodes and Clouds > your node.
JENKINS_SECRET=replace_with_real_secret
